\PassOptionsToPackage{unicode=true}{hyperref}
\providecommand{\xmpquote}[1]{#1}
\documentclass[12pt, letterpaper, oneside]{article}
\setcounter{secnumdepth}{0} % APA 7: no numbered headings

% ---- Packages ----
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{textcomp}
\usepackage{calc}
\usepackage{newtxtext}
\usepackage{geometry}
\geometry{margin=1in}
\usepackage{setspace}
\doublespacing
\usepackage{ragged2e}
\RaggedRight
\setlength{\parindent}{0.5in}
\setlength{\parskip}{0pt}
\usepackage{authblk}
\usepackage{fancyhdr}

% ---- APA 7 heading styles (all same font size) ----
\usepackage{titlesec}
\titleformat{\section}{\normalsize\bfseries\centering}{}{0pt}{}
\titleformat{\subsection}{\normalsize\bfseries}{}{0pt}{}
\titleformat{\subsubsection}{\normalsize\bfseries\itshape}{}{0pt}{}
\titleformat{\paragraph}{\normalsize\bfseries}{}{0pt}{}
\titleformat{\subparagraph}{\normalsize\bfseries\itshape}{}{0pt}{}
\titlespacing*{\section}{0pt}{0pt}{0pt}
\titlespacing*{\subsection}{0pt}{0pt}{0pt}
\titlespacing*{\subsubsection}{0pt}{0pt}{0pt}
\titlespacing*{\paragraph}{0pt}{0pt}{0pt}
\titlespacing*{\subparagraph}{0pt}{0pt}{0pt}

\usepackage{tabularx}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{hyphenat}
\newcounter{none}
\usepackage{graphicx}
\usepackage[labelfont=bf, textfont=it, labelsep=period, font=normalsize, singlelinecheck=off, position=bottom]{caption}
\renewcommand{\figurename}{Figura}
\renewcommand{\tablename}{Tabla}
\renewcommand{\listfigurename}{Índice de figuras}
\setlength{\tabcolsep}{2pt}

% Reduce font size and spacing in longtables to help columns fit
\let\originallongtable\longtable
\let\originalendlongtable\endlongtable
\renewenvironment{longtable}{\small\setlength{\LTleft}{\fill}\setlength{\LTright}{\fill}\originallongtable}{\originalendlongtable}

% APA 7 block quotes: indent 0.5in from LEFT only
\renewenvironment{quote}
  {\list{}{\leftmargin=0.5in\rightmargin=0in\parindent=0pt}\item\relax}
  {\endlist}

% Longtable + minipage: se usa flujo pandoc → .tex → xelatex ×2
$if(bibliography)$
\usepackage[style=apa, backend=biber, citestyle=apa]{biblatex}
$endif$
\usepackage{xurl}
\urlstyle{same}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\providecommand{\pandocbounded}[1]{#1}
\usepackage{microtype}
\setlength{\emergencystretch}{1em}
\usepackage{hyperref}
\hypersetup{colorlinks=true, linkcolor=black, citecolor=black, urlcolor=black, breaklinks=true}


% ---- Page numbering ----
\setlength{\headheight}{14.5pt}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}

% ---- Title page variables ----
$if(title)$
\title{$title$}
$endif$
$if(author)$
\author{$author$}
$endif$
$if(institution)$
\affil{$institution$}
$endif$
$if(date)$
\date{$date$}
$endif$

% ---- Abstract ----
$if(abstract)$
\newcommand{\abstractText}{$abstract$}
$endif$

% ---- Keywords ----
$if(keywords)$
\newcommand{\keywordText}{$for(keywords)$$keywords$$sep$, $endfor$}
$endif$

% ---- Bibliography ----
$if(bibliography)$
\addbibresource{$bibliography$}
$endif$

% ---- Hanging indent for references ----
\newenvironment{refsect}{%
  \parindent=0pt\emergencystretch=1em
  \everypar{\hangindent=0.5in\hangafter=1}%
}{%
  \par\everypar{}%
}

% ---- Body ----
\begin{document}

% ---- Title page ----
\begin{titlepage}
\thispagestyle{fancy}
\centering
\vspace*{3cm}
{\doublespacing
{\LARGE \bfseries $title$ \par}
\vspace{1.5cm}
{\large $author$ \par}
\vspace{0.5cm}
{\large $institution$ \par}
\vspace{0.5cm}
{\large $course$ \par}
\vspace{0.3cm}
{\large $professor$ \par}
\vspace{1.5cm}
{\large $date$ \par}
\vfill
}
\end{titlepage}

\setcounter{page}{2}

% ---- Abstract page (starts on page 2 per APA 7) ----
$if(abstract)$
{\centering\textbf{\normalsize $if(abstract-label)$$abstract-label$$else$Abstract$endif$}\par}
\noindent\abstractText\par
$if(keywords)$
$if(keywords-label)$\textit{$keywords-label$}$else$\textit{Keywords:}$endif$ \keywordText
$endif$
$endif$

% ---- Table of Contents ----
$if(toc)$
\newpage
$if(toc-label)$\renewcommand{\contentsname}{$toc-label$}$endif$
\tableofcontents
\newpage
$if(lof)$
\listoffigures
\addcontentsline{toc}{section}{\listfigurename}
\newpage
$endif$
$endif$

% ---- Body ----
\newpage
$body$

% ---- References ----
\newpage
$if(bibliography)$
\printbibliography[heading=bibintoc, title={References}]
$endif$

\end{document}
